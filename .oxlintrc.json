{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "jsPlugins": ["eslint-plugin-i18next"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-console": "error",
    "no-debugger": "error",
    "no-alert": "error",
    "no-eval": "error",
    "react/no-danger": "error",
    "i18next/no-literal-string": [
      "error",
      {
        "mode": "jsx-only",
        "jsx-attributes": {
          "include": ["aria-label", "title", "placeholder", "alt"],
          "exclude": [".*"]
        },
        "callees": {
          "exclude": [
            "i18n(ext)?",
            "t",
            "loc",
            "require",
            "addEventListener",
            "removeEventListener",
            "includes",
            "indexOf",
            "endsWith",
            "startsWith"
          ]
        },
        "message": "ข้อความ UI ต้องผ่าน t('key') เท่านั้น"
      }
    ]
  },
  "overrides": [
    {
      "files": ["scripts/**", "**/*.test.js"],
      "rules": { "no-console": "off" }
    }
  ],
  "ignorePatterns": ["dist", "node_modules"]
}
