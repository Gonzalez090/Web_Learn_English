# ตัวอย่างค่าที่ใส่ใน .env.local (ไฟล์จริงห้ามขึ้น GitHub)

# ระบบบัญชี Google (ขั้นที่ 31) — ค่าสาธารณะ 2 ตัวนี้อยู่ในหน้าเว็บได้ (Supabase → Project Settings → API Keys)
# ห้ามใส่ secret key / service_role key เด็ดขาด (npm run build จะหยุดถ้าเจอ)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ค้นภาพ (scripts/fetch-images.mjs) — ของลับ ห้ามตั้งชื่อขึ้นต้นด้วย VITE_
PIXABAY_API_KEY=
